# Academic, Research & Industry Ecosystem Configuration

# Core Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & JWT
JWT_SECRET_KEY=change_this_super_secret_jwt_key_in_production_min_32_chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Production: PostgreSQL, Local fallback: SQLite)
# PostgreSQL example: postgresql+psycopg2://postgres:postgres@localhost:5432/ecosystem_db
# Docker compose example: postgresql+psycopg2://postgres:postgres@postgres:5432/ecosystem_db
DATABASE_URL=sqlite:///./ecosystem.db

# AI Service Configuration
AI_PROVIDER=local
# Optional: Live Google Gemini API Key
GEMINI_API_KEY=

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Email (Mock / SMTP)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
